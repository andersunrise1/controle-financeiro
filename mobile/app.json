{
  "expo": {
    "name": "Divisa",
    "slug": "divisa",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon-divisa-1024.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#2d2d2d",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.divisa.mobile"
    },
    "android": {
      "package": "com.divisa.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#ff8c42",
        "foregroundImage": "./assets/adaptive-icon-foreground.png"
      },
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon-divisa.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon-divisa.png",
          "imageWidth": 320,
          "resizeMode": "contain",
          "backgroundColor": "#2d2d2d"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "7e2e167c-81ab-4a6d-b32d-c36ae03a9310"
      }
    },
    "owner": "techspeaking"
  }
}
