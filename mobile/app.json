{
  "expo": {
    "name": "Divisa",
    "slug": "divisa",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon-divisa-1024.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#2d2d2d",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.divisa.mobile"
    },
    "android": {
      "package": "com.divisa.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#2d2d2d",
        "foregroundImage": "./assets/adaptive-icon-foreground.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon-divisa.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon-divisa.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#2d2d2d"
        }
      ]
    ]
  }
}
