# Copie para .env.local e preencha. Nenhum valor real deve entrar neste arquivo:
# ele é versionado, ao contrário do .env.local.

# Assina os tokens de sessão. OBRIGATÓRIO em produção — sem ele o servidor
# se recusa a autenticar em vez de cair numa chave de desenvolvimento que
# está publicada neste repositório. Gere um valor longo e aleatório.
JWT_SECRET=

# Origens permitidas pelo CORS, separadas por vírgula. A primeira também é
# usada para montar o link de redefinição de senha enviado por e-mail.
FRONTEND_URL=http://localhost:3000

# A única conta que enxerga a área administrativa. Não há papel guardado no
# banco: é a comparação com este e-mail.
ADMIN_EMAIL=

# Envio de e-mail, hoje usado só pela recuperação de senha. Qualquer provedor
# SMTP serve (Brevo, SendGrid, Mailgun, Gmail com senha de app).
#
# Sem estas variáveis o aplicativo continua funcionando normalmente e apenas
# /api/auth/forgot-password responde 503 com uma mensagem clara.
#
# MAIL_FROM precisa ser um remetente que o provedor tenha autorizado, senão a
# mensagem é aceita e depois descartada silenciosamente.
# CAMINHO PREFERIDO: a API HTTPS da Brevo.
#
# Existe por um motivo concreto: o Railway bloqueia TODAS as portas de SMTP
# de saída (25, 465, 587, 2525) nos planos Free, Trial e Hobby, e só libera
# no Pro. O sintoma não é um erro — a conexão simplesmente pendura — então
# parece problema de senha por um bom tempo.
#
# A API sai pela porta 443, que nenhum provedor bloqueia. A chave fica em
# app.brevo.com > SMTP & API > aba "API keys" (NÃO é a mesma chave do SMTP).
#
# Definindo isto, as variáveis SMTP_* abaixo ficam sem uso.
BREVO_API_KEY=

# CAMINHO ALTERNATIVO: SMTP puro. Serve em qualquer hospedagem que não
# bloqueie as portas de e-mail, e mantém a porta aberta para trocar de
# provedor sem mexer em código.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=DIVISA
